{
  "name": "headhunter-backend",
  "version": "0.0.1",
  "description": "Headhunter API - job search and recruitment backend",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "biome format --write src migrations",
    "format:check": "biome format src migrations",
    "lint": "eslint \"{src,migrations}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,migrations}/**/*.ts\"",
    "test": "jest --forceExit --detectOpenHandles",
    "test:int": "jest --forceExit --detectOpenHandles --testRegex \".*\\.int\\.spec\\.ts$\" --testPathIgnorePatterns \"/node_modules/\"",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --forceExit",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "tunnel:up": "docker compose -f docker-compose.tunnel.yml up -d",
    "tunnel:down": "docker compose -f docker-compose.tunnel.yml down",
    "tunnel:logs": "docker compose -f docker-compose.tunnel.yml logs -f cloudflared",
    "migrate:latest": "tsx src/infra/db/migrate.ts latest",
    "migrate:up": "tsx src/infra/db/migrate.ts up",
    "migrate:down": "tsx src/infra/db/migrate.ts down",
    "migrate:status": "tsx src/infra/db/migrate.ts status",
    "seed": "tsx src/infra/db/seed.ts",
    "migrate:typecheck": "tsc --noEmit -p tsconfig.migrate.json",
    "kysely:generate": "kysely-codegen --date-parser string --out-file ./src/infra/db/database.types.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@scalar/nestjs-api-reference": "^1.0.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "joi": "^18.2.3",
    "jose": "^6.2.8",
    "kysely": "^0.29.4",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "\\.int\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm/)?(kysely|jose))"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@infra/(.*)$": "<rootDir>/infra/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
