# Copy to .env for local development. .env is gitignored - never commit secrets.

NODE_ENV=development

# 3001, not 3000: the `sahih-bot` container already publishes host port 3000.
HTTP_PORT=3001

# Must match docker-compose.dev.yml. Host port is 5435 to avoid the other
# Postgres instances running on this machine (5432/5433/5434).
DB_HOST=localhost
DB_PORT=5435
DB_NAME=headhunter
DB_USER=headhunter
DB_PASSWORD=local_dev_password

# Used by kysely-codegen and the migration runner.
DATABASE_URL=postgres://headhunter:local_dev_password@localhost:5435/headhunter

# Comma-separated list of allowed origins, or * for local development.
CORS_ORIGINS=*

# --- Backups (docs/BACKUP.md) ------------------------------------------------
# Read by docker-compose.backup.yml, not by the application - Compose substitutes
# them, and the API ignores them (the env schema allows unknown keys). Both have
# defaults in the compose file, so an .env without them still works.
#
# 21:00 UTC is 02:00 in Tashkent: after the working day rather than during it.
BACKUP_AT_HOUR=21
BACKUP_RETENTION_DAYS=14

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Human-readable logs via pino-pretty, instead of raw JSON. Defaults to on unless
# NODE_ENV=production. Leave it unset on the host; the container sets it to false,
# because pino-pretty is a devDependency and the image carries production
# dependencies only.
# LOG_PRETTY=true

# Every client-facing timestamp is rendered in this zone with an explicit
# numeric offset (docs/API_CONTRACTS.md 2). Storage stays UTC.
PLATFORM_TIME_ZONE=Asia/Tashkent

# --- Auth -------------------------------------------------------------------
# Both secrets must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace_me_with_at_least_32_random_characters
# HMAC key for OTP and refresh-token hashes. Rotating it invalidates every live
# OTP and refresh token - that blast radius is intended.
TOKEN_HASH_PEPPER=replace_me_with_at_least_32_random_characters

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 4.2 requires TTL, resend delay and attempt limits to be server configuration.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_DELAY_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Development convenience: returns the code in the send response instead of
# sending an SMS. Boot refuses this when NODE_ENV=production.
OTP_ECHO_IN_RESPONSE=true
# Issue this fixed code instead of a random one, so login works before an SMS
# provider exists. It is substituted at the point the random code is generated and
# nowhere else, so TTL, resend delay, attempt limits and single-use consumption
# all still apply - clearing this variable is the entire removal. Boot refuses a
# non-empty value when NODE_ENV=production. Must be exactly OTP_LENGTH digits.
OTP_STATIC_CODE=666666

# --- SMS delivery (Eskiz.uz, docs/SMS_PROVIDER.md) ---------------------------
# EMPTY IS A SUPPORTED STATE, exactly as for FCM. With ESKIZ_EMAIL unset the API
# issues and stores codes but sends nothing, logs a warning at boot and one per
# send, and never claims a delivery - OTP_STATIC_CODE and OTP_ECHO_IN_RESPONSE
# above are how anybody signs in until an account exists.
#
# The credential is an account LOGIN, not an issued key: Eskiz has no API key, so
# the bearer token is obtained with these and re-obtained when it expires. Setting
# the email without the password is refused at boot.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# The originator on the account: the shared short code, or a branded sender if the
# account has one. Ask on purchase.
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz
# Shorter than the file timeouts: a login screen is waiting on this one.
ESKIZ_TIMEOUT_MS=10000

# --- Rate limiting (12.5) ----------------------------------------------------
# Number of reverse proxies in front of the service. 0 ignores X-Forwarded-For
# and uses the socket address. Per-IP limits need the real caller, so set this
# to the actual hop count in deployment - but only if a proxy is really there:
# trusting the header without one lets any caller spoof its address.
TRUSTED_PROXY_HOPS=0

# One window for every bucket. Per-phone limits are tight because each send
# costs an SMS; per-IP limits are loose because mobile networks NAT many users
# behind one address.
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_OTP_PER_PHONE=5
RATE_LIMIT_OTP_PER_IP=30
RATE_LIMIT_AUTH_PER_PHONE=20
RATE_LIMIT_AUTH_PER_IP=120
RATE_LIMIT_FILES_PER_IP=120
# §7's candidate search is the heaviest read in the product, so it gets its own
# budget rather than sharing authentication's.
RATE_LIMIT_SEARCH_PER_IP=240
# The fifth and loosest of §12.5's buckets. A conversation is bursty, and what this
# stops is a script rather than somebody typing quickly - §9.1's block is the answer
# to one person harassing another.
RATE_LIMIT_MESSAGING_PER_IP=600

# --- The Coin economy (§6.6, §10.5) ------------------------------------------
# Server-side business configuration, which §6.6 requires: the Flutter app reads these
# from GET /wallet and never hard-codes them. Defaults are the specification's stated
# initial values - 1 Coin = UZS 10,000, an unlock costs 2 Coins, a new employer gets 10.
#
# Changing a value affects FUTURE transactions only (§10.5). Every ledger row stores the
# price it was priced at, so history is never restated by a repricing.
#
# CANDIDATE_UNLOCK_COINS may not be 0: a free unlock makes BR-16 vacuous and puts contact
# details behind a gate that opens for everyone. Boot refuses it.
COIN_PRICE_UZS=10000
CANDIDATE_UNLOCK_COINS=2
EMPLOYER_REGISTRATION_BONUS_COINS=10

# --- Candidate search (§7) ---------------------------------------------------
# How far the count-before-open counts before answering "n+" (§7.2 "where
# technically reasonable"). Configuration because the point at which an exact
# count stops being reasonable depends on the size of the database.
SEARCH_COUNT_CAP=200

# --- Push notifications (§9.2, FCM) ------------------------------------------
# The Firebase service-account JSON, base64-encoded. Firebase console → Project
# settings → Service accounts → Generate new private key, then:
#
#   base64 -w0 service-account.json
#
# Base64 because the document is multi-line and its private key contains newlines,
# which .env files handle badly enough that most failures would be quoting mistakes.
#
# EMPTY IS A SUPPORTED STATE. Notifications are still written and read in-app; only
# the push is skipped, with a warning at boot and one per dispatch. Nothing pretends
# to have delivered. Set it when the client provides a Firebase project.
#
# FCM itself is free and works with a sideloaded APK - what it needs is Google Play
# services on the device, which a post-2019 Huawei does not have. Those users lose
# the banner and nothing else, because the in-app list is the record.
FCM_SERVICE_ACCOUNT_BASE64=
FCM_TIMEOUT_MS=10000

# --- File storage (Telegram Bot API) -----------------------------------------
# Bytes live in a Telegram chat; this API keeps the metadata and proxies every
# download after an ownership check. See README "File storage".
#
# The token is not an ordinary secret: Telegram's file_id values are per-bot, so
# replacing it orphans every file already stored. Rotate it only with a plan.
TELEGRAM_BOT_TOKEN=123456789:replace_me_with_the_token_from_BotFather
# Where uploads are sent. A numeric chat id (negative for a group or channel) or
# an @channelusername. Whoever can read this chat can read every uploaded CV, so
# it should be a private channel with the bot as its only other member.
TELEGRAM_STORAGE_CHAT_ID=-1001234567890
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=30000

# 10 MB, matching the client contract. Hard ceiling is 20971520 (20 MB): the Bot
# API refuses to *download* anything larger, so a bigger file could be stored and
# never read back. Boot rejects a larger value.
FILE_MAX_SIZE_BYTES=10485760

# --- Login (docs/TELEGRAM_LOGIN_SETUP.md) ------------------------------------
# Phone + OTP is the MVP login path (§4.1, UAT-01). Setting this to false closes
# /auth/otp/* with a 404 - see OtpEnabledGuard for why 404 and not 403.
OTP_LOGIN_ENABLED=true

# --- moderation, on since M10 ------------------------------------------------
# BOTH OF THESE NEED AN ADMINISTRATOR ACCOUNT TO EXIST ON THE INSTANCE. There is no
# route that grants the admin role - `POST /auth/roles` refuses it by design - so the
# first one is granted by hand, once:
#
#   INSERT INTO user_roles (user_id, role)
#   SELECT id, 'admin' FROM users WHERE phone = '+998901234567';
#
# On an instance with no administrator, set both to false: otherwise every employer
# parks in `under_review` and every vacancy in `under_moderation` with nobody able to
# decide, which closes the whole employer half of the product.

# Whether an employer verification submission waits for a human decision (§6.1).
# While off, submitting verifies immediately - and still writes its BR-08 audit row
# with a null actor and an `auto_verified_no_reviewer` reason, so the trail never
# claims a person reviewed anything.
EMPLOYER_VERIFICATION_ENABLED=true

# Whether a submitted vacancy waits for a moderator (§6.4, BR-04). While off, submit
# publishes directly - still writing its BR-08 row with an auto_approved_no_moderator
# reason.
#
# It never covered BR-12: a vacancy with an age or gender restriction is sent for review
# regardless of this flag, because BR-12 makes administrator review part of the rule.
# From M5 until M10 that meant such a vacancy could not publish at all; now the
# moderation queue flags it and approving it is the only way it ever does.
MODERATION_ENABLED=true

# Telegram login is deprecated (2026-08-05): the app no longer calls
# /auth/telegram. The endpoint still works and the settings below still configure
# it, because the JWKS verification is correct and re-enabling it is cheaper than
# rebuilding it.
# Numeric bot id - the part of TELEGRAM_BOT_TOKEN before the colon. This is the
# audience an id_token must be addressed to, and checking it is the only thing
# stopping a Telegram token minted for another app from signing someone in here.
TELEGRAM_LOGIN_BOT_ID=1234567890
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
# Must be https in production: signing keys fetched over plaintext can be
# substituted, which forges every login. http is allowed outside production so the
# API can run against a local Telegram stub.
TELEGRAM_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
# How old an id_token may be by its `iat`. The replay window - a captured token is
# refused after this even though `exp` is an hour out. The app must post the token
# promptly and never cache one.
TELEGRAM_ID_TOKEN_MAX_AGE_SECONDS=300
# Refuse a login whose `phone` scope was declined. On by default: BR-09 contact
# exposure has nothing to reveal without a phone number.
TELEGRAM_REQUIRE_PHONE=true

# --- Public exposure (docs/DEPLOYMENT.md) ------------------------------------
# Behind the Cloudflare tunnel set this to cf-connecting-ip, or every caller looks
# like 127.0.0.1 and the whole world shares one rate-limit bucket. NOT
# x-forwarded-for: Cloudflare puts the user's address first and its own second,
# which is the opposite order to what Express's trust-proxy hop count reads, and
# Cloudflare appends to a client-supplied XFF rather than replacing it. Only ever
# read when named here - with nothing in front, anyone could send it.
CLIENT_IP_HEADER=

# Makes Express proxy-aware so req.protocol/req.secure reflect the original HTTPS
# request. Separate from the line above and NOT what rate limiting reads. 1 behind
# the tunnel, 0 with nothing in front.
TRUSTED_PROXY_HOPS=0

# /docs and /reference describe every endpoint and payload. Useful to the mobile
# devs, and public once the hostname is: either turn this off or put a Cloudflare
# Access policy on those two paths.
API_DOCS_ENABLED=true

# Operator-facing only - makes the boot log print real URLs. Never used to build a
# client-facing link.
PUBLIC_BASE_URL=
