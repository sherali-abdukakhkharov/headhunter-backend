# Copy to .env for local development. .env is gitignored - never commit secrets.

NODE_ENV=development
HTTP_PORT=3000

# Must match docker-compose.dev.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=headhunter
DB_USER=headhunter
DB_PASSWORD=local_dev_password

# Used by kysely-codegen and the migration runner.
DATABASE_URL=postgres://headhunter:local_dev_password@localhost:5432/headhunter

# Comma-separated list of allowed origins, or * for local development.
CORS_ORIGINS=*

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
