# Copy to .env for local development. .env is gitignored - never commit secrets.

NODE_ENV=development

# 3001, not 3000: the `sahih-bot` container already publishes host port 3000.
HTTP_PORT=3001

# Must match docker-compose.dev.yml. Host port is 5435 to avoid the other
# Postgres instances running on this machine (5432/5433/5434).
DB_HOST=localhost
DB_PORT=5435
DB_NAME=headhunter
DB_USER=headhunter
DB_PASSWORD=local_dev_password

# Used by kysely-codegen and the migration runner.
DATABASE_URL=postgres://headhunter:local_dev_password@localhost:5435/headhunter

# Comma-separated list of allowed origins, or * for local development.
CORS_ORIGINS=*

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
